/* Container to keep elements stacked and centered */
.textarea-group {
  display: flex;
  flex-direction: column;
  align-items: center; /* Horizontally centers the label */
  width: 100%;         /* Adjust width as needed for your form card */
  margin-bottom: 20px;
}

/* Centered Label above the textarea */
.textarea-label {
  text-align: center;
  font-weight: 500;
  color: #555;
  margin-bottom: 8px; /* Space between the text label and the box */
}

/* Textarea Box */
textarea {
  width: 100%;        /* Fills the container width */
  min-height: 120px;  /* Gives it height like in your mockup */
  border-radius: 12px;/* Rounded corners */
  border: 1px solid #ccc;
  padding: 12px;
  box-sizing: border-box; /* Prevents padding from breaking layout width */
  resize: vertical;   /* Allows vertical resizing only */
}